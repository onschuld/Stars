.stars_handbookinner {
    margin-bottom: 10px;
}
  
  .starsgbcontent {
    overflow-y: hidden !important;
    overflow-x: clip;
}
  
  
.bestiary_info, .bestiary_text {
    width: calc(50% - 5px);
    height: 575px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 99;
}

  
  .starsgb_headtit {
    z-index: 99;
    font-family: 'Cormorant';
    text-transform: uppercase;
    font-size: 26px;
    letter-spacing: 5px;
    text-shadow: 0px 0px 10px black;
}

.bestiary_text {
    font-size: 15px;
    padding: 0px 40px;
    line-height: 200%;
    text-align: justify;
}

.bestiary_text i {
    color: var(--textcoloraccent2);
    font-family: 'Cormorant';
    font-weight: 200;
    font-size: 19px;
}

img.bestiary_img {
    width: 100%;
    height: 471px;
    object-fit: contain;
    object-position: center;
    margin-bottom: -50px;
    position: absolute;
    top: -180px;
    filter: drop-shadow(2px 4px 6px #000000aa);
}

.bestiary_table {
    background: var(--stars_bgc5);
    border: var(--stars_border);
    padding: 20px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.bestiary_table h1 {
    text-align: left;
    font-weight: 200;
    color: var(--textcoloraccent);
    border: 0px;
    margin: 0px;
}

.bestiary_blocks {
    border-top: 2px solid #ffffff17;
    border-bottom: 2px solid #ffffff17;
    display: flex;
    justify-content: space-between;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    padding: 10px 0px;
    width: 100%;
}

.best_block {
    width: calc(50% - 5px);
    background: var(--stars_bgc);
    line-height: 35px;
    padding: 0px 10px;
    border: var(--stars_border);
    color: var(--textcoloraccent2);
    text-align: right;
}

.best_block b {
    font-family: 'Cormorant';
    float: left;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--textcoloraccent);
}

.best_item {
    line-height: 35px;
    text-align: right;
    font-size: 14px;
    padding: 0px 5px;
}
  
.bestiary_bottom {
    position: relative;
    width: 100%;
    height: 30px;
    display: flex;
    justify-content: center;
    flex-direction: row;
    flex-wrap: wrap;
    top: 15px;
}

.bestiary_bottom .gentit {
    height: 50px;
    font-size: 21px;
    width: 50%;
    top: 0px;
    font-weight: 200 !important;
}

.bestiary_list {
    width: 73%;
    margin: 10px 0px;
}

.best_item b {
    float: left;
    font-family: 'Cormorant';
    font-size: 16px;
    font-weight: 200;
    letter-spacing: 2px;
    color: var(--textcoloraccent);
}

.bestiary_icon {
    width: 100px;
    height: 100px;
    border: var(--stars_border);
    border-radius: 100%;
    background: var(--stars_bgc4);
    margin: 10px 0px;
    padding: 10px;
}
  
  img.best_icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: invert(1) drop-shadow(0px 0px 6px black);
    opacity: 0.7;
}

.bestiary_tags {
    width: 100%;
    height: 51px;
    border-top: 2px solid #ffffff17;
    padding: 10px 0px;
    display: flex;
    gap: 5px;
}

.besttag {
    width: 29px;
    aspect-ratio: 1 / 1;
    position: relative;
    border: var(--stars_border);
    border-radius: 100%;
    overflow: hidden;
    padding: 5px;
    background: var(--stars_bgc4);
}

#petfriendly {
    --besttag: url(https://2img.net/i.imgur.com/6RuAwZW.png);
}

.besttag::before {
    width: 17px;
    aspect-ratio: 1 / 1;
    content: "";
    position: absolute;
    background: var(--besttag);
    background-size: contain;
    filter: invert(1);
    background-position: center;
    background-repeat: no-repeat;
}  
  
  
  .bestbot_sides {
    width: 90.3%;
    height: 32px;
    display: flex;
    justify-content: space-between;
    background: var(--stars_bgc5);
    border-top: 2px solid #ffffff17;
    border-bottom: 2px solid #ffffff17;
    margin-top: 18px;
    position: relative;
}

.bestbot_side {
    display: flex;
    width: 40%;
}

.diamondsh.bbs_img {
    width: 58px;
    height: 58px;
    top: -36px;
    position: absolute;
}

.diamondsh.bbs_img img {
    width: 74px;
    height: 74px;
}

.diamondsh.bbs_img::before, .diamondsh.bbs_img::after {
    width: 54px;
}

#bestbots_right .diamondsh.bbs_img {right: -30px}
#bestbots_left .diamondsh.bbs_img {left: -30px}
  
  div#bestbots_right {
    flex-direction: row-reverse;
}

a.bbs {
    margin: 0px 40px;
    line-height: 27px;
    text-transform: uppercase;
    color: var(--textcoloraccent2);
    letter-spacing: 1px;
    font-family: 'Lato';
}
  
